# Python environment for workflow on Hera

echo "setting spack module directory"
module use /contrib/spack-stack/spack-stack-1.5.1/envs/gsi-addon-rocky8/install/modulefiles/Core/
echo "loading intel stack"
module load stack-intel/2021.5.0
